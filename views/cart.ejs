<%- include("partials/header") %><section class="max-w-5xl mx-auto px-5 py-12"><h1 class="serif text-4xl mb-8">Your bag</h1><% if(!items.length){ %><p class="text-stone-500">Your bag is waiting for something lovely.</p><a href="/products" class="inline-block mt-5 underline">Continue shopping →</a><% } else { %><div class="space-y-5"><% items.forEach(i=>{ %><div class="flex gap-5 border-b pb-5"><img src="<%= i.product.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=300' %>" class="w-24 h-28 object-cover rounded-lg"><div class="flex-1"><h2 class="font-semibold"><%= i.product.name %></h2><p class="text-stone-500 mt-1">₹<%= i.product.price.toLocaleString('en-IN') %></p><form action="/cart/update/<%= i.product._id %>" method="POST" class="flex gap-2 mt-3"><input name="quantity" type="number" min="1" max="<%= i.product.stock %>" value="<%= i.quantity %>" class="border rounded px-2 py-1 w-16"><button class="underline text-sm">Update</button></form></div><div class="text-right"><p class="font-semibold">₹<%= (i.product.price*i.quantity).toLocaleString('en-IN') %></p><form action="/cart/remove/<%= i.product._id %>" method="POST"><button class="text-xs underline text-stone-500 mt-3">Remove</button></form></div></div><% }) %></div><div class="max-w-sm ml-auto mt-8"><div class="flex justify-between text-lg font-semibold"><span>Subtotal</span><span>₹<%= total.toLocaleString('en-IN') %></span></div><p class="text-xs text-stone-500 mt-2">Shipping and taxes, if applicable, are calculated at checkout.</p><a href="/orders/checkout" class="block text-center bg-[#252321] text-white rounded-full py-4 mt-6">Continue to checkout</a></div><% } %></section><%- include("partials/footer") %>

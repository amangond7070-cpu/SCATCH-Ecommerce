<%- include("partials/header") %><section class="max-w-md mx-auto px-5 py-20"><h1 class="serif text-4xl"><%= mode==='login'?'Welcome back':'Create your account' %></h1><p class="text-stone-500 mt-2"><%= mode==='login'?'Sign in to continue shopping.':'Join SCATCH for a more personal shopping experience.' %></p><% if(error){ %><p class="bg-red-50 text-red-700 p-3 rounded-lg mt-5 text-sm"><%= error %></p><% } %><form action="/auth/<%= mode %>" method="POST" class="mt-7 space-y-4"><% if(mode==='register'){ %><input name="name" required placeholder="Full name" class="w-full border bg-white rounded-lg p-3"><% } %><input name="email" type="email" required placeholder="Email address" class="w-full border bg-white rounded-lg p-3"><input name="password" type="password" minlength="8" required placeholder="Password (minimum 8 characters)" class="w-full border bg-white rounded-lg p-3"><button class="w-full bg-[#252321] text-white rounded-full py-3"><%= mode==='login'?'Sign in':'Create account' %></button></form><p class="text-sm mt-6 text-stone-500"><%= mode==='login'?'New here?':'Already have an account?' %> <a class="underline text-black" href="/auth/<%= mode==='login'?'register':'login' %>"><%= mode==='login'?'Create an account':'Sign in' %></a></p></section><%- include("partials/footer") %>

<%- include("partials/header") %><section class="max-w-5xl mx-auto px-5 py-12"><h1 class="serif text-4xl mb-8">Your orders</h1><% if(!orders.length){ %><p class="text-stone-500">You haven't placed an order yet.</p><% } %><div class="space-y-4"><% orders.forEach(o=>{ %><div class="bg-white border rounded-xl p-5"><div class="flex flex-wrap justify-between gap-3"><div><p class="text-xs text-stone-500">ORDER #<%= o._id %></p><p class="font-semibold mt-1"><%= o.status %></p></div><div class="text-right"><p class="font-bold">₹<%= o.total.toLocaleString('en-IN') %></p><p class="text-xs text-stone-500"><%= o.paymentMethod %> · <%= o.paymentStatus %></p></div></div><div class="mt-4 text-sm text-stone-600"><%= o.items.map(i=>`${i.name} × ${i.quantity}`).join(' · ') %></div><p class="text-xs text-stone-500 mt-3">Deliver to: <%= o.address %></p></div><% }) %></div></section><%- include("partials/footer") %>

<%- include("partials/header") %><section class="max-w-lg mx-auto px-5 py-20 text-center"><h1 class="serif text-3xl">Complete your payment</h1><p class="text-stone-500 mt-3">Order total: ₹<%= order.total.toLocaleString('en-IN') %></p><button id="pay" class="bg-[#252321] text-white rounded-full px-8 py-4 mt-8">Pay securely</button></section><script src="https://checkout.razorpay.com/v1/checkout.js"></script><script>document.getElementById('pay').onclick=()=>{const r=new Razorpay({key:"<%= key %>",amount:<%= rpOrder.amount %>,currency:"INR",name:"SCATCH",description:"Order <%= order._id %>",order_id:"<%= rpOrder.id %>",handler:async response=>{const r=await fetch('/orders/verify-payment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...response,orderId:"<%= order._id %>"})});if(r.ok)location.href='/orders/mine';else alert(await r.text())}});r.open()};</script><%- include("partials/footer") %>

<%- include("partials/header") %><section class="max-w-7xl mx-auto px-5 py-12"><h1 class="serif text-4xl">Admin dashboard</h1><p class="text-stone-500 mt-2">Manage your catalogue and customer orders.</p><div class="grid md:grid-cols-2 gap-8 mt-10"><form action="/admin/products" method="POST" enctype="multipart/form-data" class="bg-white border rounded-xl p-6 space-y-3"><h2 class="font-bold text-xl">Add a product</h2><input name="name" required placeholder="Product name" class="w-full border rounded p-3"><textarea name="description" placeholder="Description" class="w-full border rounded p-3"></textarea><div class="grid grid-cols-2 gap-3"><input name="price" type="number" min="0" step=".01" required placeholder="Price (₹)" class="border rounded p-3"><input name="stock" type="number" min="0" required placeholder="Stock" class="border rounded p-3"></div><input name="category" placeholder="Category" class="w-full border rounded p-3"><input name="image" type="file" accept="image/*" class="w-full text-sm"><label class="text-sm"><input name="featured" type="checkbox"> Featured product</label><button class="bg-[#252321] text-white rounded-full px-6 py-3 w-full">Create product</button></form><div class="bg-white border rounded-xl p-6"><h2 class="font-bold text-xl mb-4">Products (<%= products.length %>)</h2><div class="space-y-3 max-h-[480px] overflow-auto"><% products.forEach(p=>{ %><div class="flex justify-between gap-3 border-b pb-3"><div><p class="font-semibold"><%= p.name %></p><p class="text-xs text-stone-500">₹<%= p.price %> · Stock <%= p.stock %></p></div><form action="/admin/products/<%= p._id %>/delete" method="POST"><button class="text-red-700 text-xs underline">Delete</button></form></div><% }) %></div></div></div><div class="mt-12"><h2 class="serif text-3xl mb-5">Recent orders</h2><div class="space-y-3"><% orders.forEach(o=>{ %><div class="bg-white border rounded-xl p-4 flex flex-wrap justify-between gap-4"><div><p class="font-semibold">₹<%= o.total.toLocaleString('en-IN') %> · <%= o.status %></p><p class="text-xs text-stone-500">Order <%= o._id %> · <%= o.createdAt.toLocaleDateString() %></p></div><form action="/admin/orders/<%= o._id %>/status" method="POST" class="flex gap-2"><select name="status" class="border rounded px-2"><% ['PROCESSING','SHIPPED','DELIVERED','CANCELLED'].forEach(s=>{ %><option <%= o.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="bg-stone-900 text-white rounded px-4 text-sm">Update</button></form></div><% }) %></div></div></section><%- include("partials/footer") %>

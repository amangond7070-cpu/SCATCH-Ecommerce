<%- include("partials/header") %><section class="max-w-7xl mx-auto px-5 pt-12 pb-16"><div class="rounded-[2rem] overflow-hidden bg-[#e9e1d5] grid md:grid-cols-2 min-h-[440px]"><div class="p-9 md:p-16 flex flex-col justify-center"><p class="uppercase tracking-[.25em] text-xs font-bold text-amber-900">The new everyday</p><h1 class="serif text-5xl md:text-6xl leading-tight mt-5">Find your<br>everyday <i>favourite.</i></h1><p class="mt-5 text-stone-600 max-w-sm">A considered collection of pieces made to fit your life.</p><a href="/products" class="mt-8 bg-[#252321] text-white rounded-full px-7 py-3 w-fit text-sm">Explore collection →</a></div><div class="min-h-[300px] bg-cover bg-center" style="background-image:url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1200')"></div></div></section><section class="max-w-7xl mx-auto px-5"><div class="flex justify-between items-end mb-7"><div><p class="uppercase text-xs tracking-widest text-amber-800 font-bold">Curated for you</p><h2 class="serif text-3xl mt-2">Latest arrivals</h2></div><a href="/products" class="text-sm underline">View all</a></div><div class="grid grid-cols-2 md:grid-cols-4 gap-5"><% products.forEach(p => { %><a href="/products/<%= p._id %>" class="group"><div class="aspect-[4/5] bg-stone-200 rounded-xl overflow-hidden"><img class="w-full h-full object-cover group-hover:scale-105 transition" src="<%= p.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=700' %>" alt="<%= p.name %>"></div><h3 class="font-semibold mt-3"><%= p.name %></h3><p class="text-sm text-stone-500 mt-1">₹<%= p.price.toLocaleString("en-IN") %></p></a><% }) %></div></section><%- include("partials/footer") %>

<%- include("partials/header") %><section class="max-w-5xl mx-auto px-5 py-12"><h1 class="serif text-4xl mb-8">Checkout</h1><div class="grid md:grid-cols-2 gap-12"><form action="/orders/place" method="POST" class="space-y-5"><label class="block text-sm font-semibold">Delivery address<textarea name="address" required rows="4" placeholder="House no., street, city, state, PIN code" class="block w-full border rounded-lg p-3 mt-2"></textarea></label><div><p class="font-semibold mb-3">Payment method</p><label class="block border rounded-lg p-4 mb-2"><input type="radio" name="paymentMethod" value="COD" checked> Cash on Delivery</label><label class="block border rounded-lg p-4"><input type="radio" name="paymentMethod" value="RAZORPAY" <%= razorpayKey?'':'disabled' %>> Online payment (Razorpay) <span class="text-xs text-stone-500"><%= razorpayKey?'':'— configure API keys to enable' %></span></label></div><button class="bg-[#252321] text-white rounded-full px-8 py-4 w-full">Place order · ₹<%= total.toLocaleString('en-IN') %></button></form><div class="bg-white rounded-xl p-6 h-fit"><h2 class="font-semibold mb-4">Order summary</h2><% items.forEach(i=>{ %><div class="flex justify-between text-sm py-2"><span><%= i.product.name %> × <%= i.quantity %></span><span>₹<%= (i.product.price*i.quantity).toLocaleString('en-IN') %></span></div><% }) %><div class="border-t mt-4 pt-4 flex justify-between font-bold"><span>Total</span><span>₹<%= total.toLocaleString('en-IN') %></span></div></div></div></section><%- include("partials/footer") %>

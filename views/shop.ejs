<%- include("partials/header") %><section class="max-w-7xl mx-auto px-5 py-12"><p class="uppercase text-xs tracking-widest text-amber-800 font-bold">The collection</p><h1 class="serif text-4xl mt-2 mb-8">Shop all products</h1><form class="flex flex-wrap gap-3 mb-8"><input name="q" value="<%= query.q || '' %>" placeholder="Search products..." class="border rounded-full px-5 py-3 bg-white"><select name="category" class="border rounded-full px-4 py-3 bg-white"><option value="">All categories</option><% categories.forEach(c => { %><option <%= query.category===c?'selected':'' %>><%= c %></option><% }) %></select><select name="sort" class="border rounded-full px-4 py-3 bg-white"><option value="">Newest</option><option value="price-low" <%= query.sort==='price-low'?'selected':'' %>>Price: low to high</option><option value="price-high" <%= query.sort==='price-high'?'selected':'' %>>Price: high to low</option></select><button class="bg-[#252321] text-white rounded-full px-6">Apply</button></form><div class="grid grid-cols-2 md:grid-cols-4 gap-6"><% products.forEach(p => { %><a href="/products/<%= p._id %>" class="group"><div class="aspect-[4/5] rounded-xl bg-stone-200 overflow-hidden"><img src="<%= p.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=700' %>" class="w-full h-full object-cover group-hover:scale-105 transition" alt="<%= p.name %>"></div><p class="text-xs uppercase tracking-widest text-stone-500 mt-3"><%= p.category %></p><h2 class="font-semibold mt-1"><%= p.name %></h2><p class="mt-1">₹<%= p.price.toLocaleString("en-IN") %></p></a><% }) %></div><% if (!products.length) { %><p class="text-stone-500">No products found. Try another search.</p><% } %></section><%- include("partials/footer") %>

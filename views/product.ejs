<%- include("partials/header") %><section class="max-w-6xl mx-auto px-5 py-12 grid md:grid-cols-2 gap-12"><div class="aspect-[4/5] bg-stone-200 rounded-2xl overflow-hidden"><img class="w-full h-full object-cover" src="<%= product.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=900' %>" alt="<%= product.name %>"></div><div class="flex flex-col justify-center"><p class="uppercase tracking-widest text-xs text-amber-800 font-bold"><%= product.category %></p><h1 class="serif text-4xl mt-3"><%= product.name %></h1><p class="text-2xl mt-5">₹<%= product.price.toLocaleString("en-IN") %></p><p class="text-stone-600 leading-7 mt-6"><%= product.description %></p><p class="text-sm mt-5 <%= product.stock ? 'text-green-700':'text-red-700' %>"><%= product.stock ? `${product.stock} available` : 'Out of stock' %></p><form action="/cart/add/<%= product._id %>" method="POST" class="mt-8"><button <%= product.stock ? '' : 'disabled' %> class="bg-[#252321] disabled:opacity-40 text-white rounded-full px-8 py-4">Add to bag</button></form><p class="text-xs text-stone-500 mt-5">Secure checkout · Easy order tracking</p></div></section><%- include("partials/footer") %>
